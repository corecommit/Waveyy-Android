# Copy to local.properties (never committed) and fill in real values.
# Only local.properties is read by app/build.gradle.kts -> BuildConfig.
#sdk.dir=/path/to/android-sdk
API_BASE_URL=https://example.com/api/
SOCKET_URL=https://example.com
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=paste-supabase-anon-key-here
# Optional: direct JioSaavn deployment for song fetch + album search
# (mirrors NEXT_PUBLIC_API_URL). Blank disables those two calls.
SAAVN_API_URL=
# Optional: lyrics race providers (blank self-disables the provider).
#MUSIXMATCH_API_KEY=
#GENIUS_API_KEY=
# Release signing template (Phase 12). Keystore file itself is never committed.
#RELEASE_KEYSTORE_PATH=/path/to/waveyy-release.jks
#RELEASE_KEYSTORE_PASSWORD=
#RELEASE_KEY_ALIAS=waveyy
#RELEASE_KEY_PASSWORD=
